<?xml version="1.0" encoding="utf-8"?>
<!-- NietoCity. Created by Nieto Software. GPLv3. Landscape: palette is a
     scrollable 72dp left column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <za.co.nieto.nietocity.StatusBarView
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/ticker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#552277CC"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:singleLine="true"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/paletteScroll"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <za.co.nieto.nietocity.ToolPaletteView
                android:id="@+id/palette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </ScrollView>

        <za.co.nieto.nietocity.CityView
            android:id="@+id/cityView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
